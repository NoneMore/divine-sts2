# Optional overrides. The doctor can normally discover a standard Steam install.
STS2_GAME_ROOT=C:\Program Files (x86)\Steam\steamapps\common\Slay the Spire 2
STS2_ASSEMBLY=C:\Program Files (x86)\Steam\steamapps\common\Slay the Spire 2\data_sts2_windows_x86_64\sts2.dll
GODOT=C:\path\to\Godot_v4.5.1-stable_mono_win64.exe
DIVINE_STS2_REQUEST_TIMEOUT=60

# Keep SDK/package-manager state inside the repository when the user profile is
# read-only or when a fully isolated development environment is desired.
DOTNET_CLI_HOME=.\.tools\dotnet-home
NUGET_PACKAGES=.\.tools\nuget-packages
DOTNET_SKIP_FIRST_TIME_EXPERIENCE=1
UV_CACHE_DIR=.\.tools\uv-cache
UV_PYTHON_INSTALL_DIR=.\.tools\uv-python
UV_TOOL_DIR=.\.tools\uv-tools
UV_TOOL_BIN_DIR=.\.tools\uv-tool-bin
