# Optional local overrides. Standard Steam installs are discovered automatically.
STS2_GAME_ROOT=C:\Program Files (x86)\Steam\steamapps\common\Slay the Spire 2
GODOT=C:\path\to\Godot_v4.5.1-stable_mono_win64_console.exe
DIVINE_STS2_REQUEST_TIMEOUT=60

# Full-app sandboxes hard-link the install, and hard links cannot cross volumes.
# The default is beside the game install on the same volume. Set this only when
# you intentionally want another location on that same volume.
STS2_SANDBOX_ROOT=D:\SteamLibrary\steamapps\common\divine-sts2\full-app-sandboxes
